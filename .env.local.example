# Local docker-compose stack. Copy to .env.local and adjust.

# ── Database ─────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-something-strong

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Address this machine is reachable on
NEXTAUTH_URL=http://localhost

# ── Branding ─────────────────────────────────────────────────
PADDOCK_SITE_MODE=tenant
PADDOCK_ORG_NAME=

# ── Email (optional — leave blank to disable) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=paddock@localhost
