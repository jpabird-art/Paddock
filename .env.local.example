# ── Database ──────────────────────────────────────────────────
# Password for the local PostgreSQL container (choose something strong)
POSTGRES_PASSWORD=change-me-to-something-strong

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Set this to your Mac Mini's static IP
NEXTAUTH_URL=http://192.168.1.50

# ── Email (optional — leave blank to disable) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=paddock@hcmr.local
