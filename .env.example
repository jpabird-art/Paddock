# Copy this file to .env and fill in your values

# SQLite database file path (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth secret — generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret-minimum-32-chars"

# The URL where the app is running (change for intranet/server deployment)
# Examples:
#   Local:    http://localhost:3000
#   Intranet: http://192.168.1.50:3000
#   Domain:   http://hcmr-fleet.internal
NEXTAUTH_URL="http://localhost:3000"
