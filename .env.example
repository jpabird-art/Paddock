# Copy this file to .env and fill in your values.

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Railway, Neon, Supabase or local).
# Required in tenant mode. A marketing deployment needs no database —
# leave this unset there and migrations are skipped at boot.
DATABASE_URL="postgresql://user:password@localhost:5432/paddock?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret-minimum-32-chars"

# Full URL this deployment is served from
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"

# ── Deployment role ──────────────────────────────────────────
# "tenant"    — a customer's own paddock (default). The public site is disabled.
# "marketing" — the public product site: home, capabilities, contact, portal.
PADDOCK_SITE_MODE="tenant"

# ── Tenant deployments (PADDOCK_SITE_MODE=tenant) ────────────
# Shown in the sidebar, on the sign-in page and as the MFA issuer.
PADDOCK_ORG_NAME=""

# ── Marketing deployment (PADDOCK_SITE_MODE=marketing) ───────
# Domain that tenant instances sit under: <slug>.<domain>
PADDOCK_PORTAL_DOMAIN="paddock-ltd.com"

# Optional published tenant list. JSON:
#   [{"slug":"greenacre","name":"Greenacre Stud","url":"https://greenacre.paddock-ltd.com/login"}]
# or the compact form:
#   greenacre:Greenacre Stud,oakfield:Oakfield Equine
PADDOCK_TENANT_DIRECTORY=""

# Where contact enquiries are sent and shown
# Set this only after the mailbox exists.
PADDOCK_CONTACT_EMAIL=""
PADDOCK_CONTACT_PHONE=""
PADDOCK_CONTACT_ADDRESS="United Kingdom"
PADDOCK_CONTACT_RESPONSE_TIME="within two working days"

# ── Email (optional — leave blank to disable) ────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="paddock@localhost"

# ── First-run bootstrap (see npm run bootstrap) ──────────────
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_SERVICE_NUMBER=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_RANK=""
BOOTSTRAP_ADMIN_SQUADRON="THE_LIFE_GUARDS"
BOOTSTRAP_LOCATIONS=""

# Organisation profile: general (default) or military for legacy optional fields
PADDOCK_ORG_PROFILE=general
# Dedicated persistent volume path in a hosted deployment
UPLOAD_DIR=/app/uploads
# Enable only in deliberately provisioned demonstration deployments
PADDOCK_DEMO=false
PADDOCK_TENANT_SLUG=
