# Copy this file to .env and fill in your values

# PostgreSQL connection string (Neon, Supabase, or local)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/hcmr_fleet?sslmode=require"

# NextAuth secret — generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret-minimum-32-chars"

# The URL where the app is running (change for intranet/server deployment)
# Examples:
#   Local:    http://localhost:3000
#   Intranet: http://192.168.1.50:3000
#   Domain:   https://hcmr-fleet.internal
NEXTAUTH_URL="http://localhost:3000"

# Node environment (development | production | test)
NODE_ENV="development"
