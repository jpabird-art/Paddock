PADDOCK_SITE_MODE=tenant
PADDOCK_ORG_PROFILE=general
PADDOCK_ORG_NAME="Cairnhead Racing Yard"
PADDOCK_TENANT_SLUG=cairnhead
PADDOCK_DEMO=true
NEXTAUTH_URL=https://cairnhead.paddock-ltd.com
# Generate a unique secret in Railway for each Paddock; never commit it.
NEXTAUTH_SECRET=
# Railway reference to this project's own database service.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Mount a dedicated persistent Railway volume at this path.
UPLOAD_DIR=/app/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
