generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  VET
  FARRIER
  OFFICER
  TROOPER
}

enum HealthEventType {
  DENTAL_CHECK
  VET_CHECKUP
  VACCINATION
  FARRIERY
  CUSTOM
}

enum HealthEventStatus {
  SCHEDULED
  OVERDUE
  COMPLETED
}

enum InjurySeverity {
  MINOR
  MODERATE
  SEVERE
}

enum InjuryStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum MoveStatus {
  PLANNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum TackType {
  SADDLE
  BRIDLE
  BREASTPLATE
  GIRTH
  NUMNAH
  OTHER
}

enum TackCondition {
  SERVICEABLE
  UNSERVICEABLE
  REPAIR_NEEDED
}

enum MedicationRoute {
  ORAL
  IV
  IM
  TOPICAL
}

enum InspectionResult {
  PASS
  FAIL
  ADVISORY
}

enum AttachmentCategory {
  PASSPORT
  INJURY_PHOTO
  VET_CERTIFICATE
  DOCUMENT
  OTHER
}

enum FeedType {
  HAY
  HARD_FEED
  HIGH_ENERGY_MIX
  SUPPLEMENT
  CHAFF
  BEET_PULP
  OTHER
}

enum FeedFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  AS_NEEDED
}

enum DutyStation {
  KINGS_LIFE_GUARD
  TRAINING_WING
  HYDE_PARK_BARRACKS
  WINTER_TRAINING
}

enum Squadron {
  THE_LIFE_GUARDS
  THE_BLUES_AND_ROYALS
}

enum TaskReadiness {
  NON_TASKWORTHY
  LIMITED_ROLE
  FULL_EXERCISE
}

enum Sex {
  GELDING
  MARE
}

enum HorseRole {
  CHARGER
  CAV_BLACK
  GREY
  STANDARD
  COMP
  RMT
}

// ─── MODELS ──────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  serviceNumber String   @unique
  email         String   @unique
  passwordHash  String
  role          Role      @default(TROOPER)
  squadron      Squadron?
  rank          String?
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  totpSecret    String?
  backupCodes   String[]  @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  injuriesReported    InjuryReport[]       @relation("ReportedBy")
  injuriesResolved    InjuryReport[]       @relation("ResolvedBy")
  healthNotes         HealthNote[]
  dutyAssignments     DutyAssignment[]
  injuryNotifications InjuryNotification[]
  movesCreated        HorseMove[]          @relation("MoveCreatedBy")
  movesUpdated        HorseMove[]          @relation("MoveUpdatedBy")
  feedingPlansCreated FeedingPlan[]        @relation("FeedingPlanCreatedBy")
  medicationsAdministered MedicationRecord[] @relation("MedicationAdministeredBy")
  tackAllocationsAssigned TackAllocation[] @relation("TackAllocationAssignedBy")
  inspectionsPerformed    Inspection[]     @relation("InspectionPerformedBy")
  inspectionSchedulesCreated InspectionSchedule[] @relation("InspectionScheduleCreatedBy")
  attachmentsUploaded     Attachment[]     @relation("AttachmentUploadedBy")
  exerciseAssignmentsAsRider  ExerciseAssignment[] @relation("ExerciseRider")
  exerciseAssignmentsCreated  ExerciseAssignment[] @relation("ExerciseAssignedBy")
  exerciseNotifications       ExerciseNotification[]
  farrierRecordsCreated       FarrierRecord[]      @relation("FarrierRecordCreatedBy")

  @@map("users")
}

model Horse {
  id                String       @id @default(cuid())
  name              String
  regimentalNumber  String       @unique
  squadronNumber    String?
  breed             String
  colour            String
  dateOfBirth       DateTime
  serviceEntryDate  DateTime
  heightHands       Float
  weightKg          Float
  maxRiderWeightKg  Float
  squadron          Squadron?
  dutyStation       DutyStation  @default(HYDE_PARK_BARRACKS)
  taskReadiness     TaskReadiness @default(FULL_EXERCISE)
  isActive          Boolean      @default(true)
  photoUrl          String?
  ancillaries       String?
  currentLocationId String?
  sex               Sex?
  role              HorseRole?
  division          Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  currentLocation   Location?          @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  healthEvents      HealthEvent[]
  healthNotes       HealthNote[]
  injuryReports     InjuryReport[]
  dutyAssignments   DutyAssignment[]
  moves             HorseMove[]
  feedingPlans      FeedingPlan[]
  medicationRecords MedicationRecord[]
  tackAllocations   TackAllocation[]
  inspections       Inspection[]
  attachments       Attachment[]       @relation("HorseAttachments")
  exerciseAssignments ExerciseAssignment[]
  farrierRecords      FarrierRecord[]

  @@index([isActive, squadron])    // horse list filtered by active + squadron
  @@index([isActive, dutyStation])  // dashboard groups by station
  @@index([currentLocationId])     // moves update location FK
  @@map("horses")
}

model HealthEvent {
  id          String            @id @default(cuid())
  horseId     String
  type        HealthEventType
  status      HealthEventStatus @default(SCHEDULED)
  scheduledAt DateTime
  completedAt DateTime?
  notes       String?
  performedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, status])       // horse profile health tab, overdue queries
  @@index([status, scheduledAt])   // health schedule page sorted by date
  @@map("health_events")
}

model HealthNote {
  id        String   @id @default(cuid())
  horseId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  horse  Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@map("health_notes")
}

model InjuryReport {
  id             String          @id @default(cuid())
  horseId        String
  reportedById   String
  resolvedById   String?
  severity       InjurySeverity
  status         InjuryStatus    @default(OPEN)
  description    String
  bodyLocation   String
  reportedAt     DateTime        @default(now())
  resolvedAt     DateTime?
  resolutionNote String?
  updatedAt      DateTime        @updatedAt

  horse         Horse                @relation(fields: [horseId], references: [id], onDelete: Cascade)
  reportedBy    User                 @relation("ReportedBy", fields: [reportedById], references: [id])
  resolvedBy    User?                @relation("ResolvedBy", fields: [resolvedById], references: [id])
  notifications InjuryNotification[]
  attachments   Attachment[]         @relation("InjuryAttachments")

  @@index([horseId, status])       // horse profile injury tab
  @@index([status, reportedAt])    // injury list page filtered by status
  @@map("injury_reports")
}

model InjuryNotification {
  id             String    @id @default(cuid())
  injuryReportId String
  recipientId    String
  sentAt         DateTime  @default(now())
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?

  injuryReport InjuryReport @relation(fields: [injuryReportId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientId], references: [id])

  @@map("injury_notifications")
}

model DutyAssignment {
  id           String      @id @default(cuid())
  horseId      String
  assignedById String
  station      DutyStation
  startDate    DateTime    @default(now())
  endDate      DateTime?
  notes        String?
  createdAt    DateTime    @default(now())

  horse      Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  assignedBy User  @relation(fields: [assignedById], references: [id])

  @@index([horseId, endDate])      // find current assignment (endDate IS NULL)
  @@map("duty_assignments")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horsesCurrently Horse[]     @relation("CurrentLocation")
  movesFrom       HorseMove[] @relation("FromLocation")
  movesTo         HorseMove[] @relation("ToLocation")

  @@map("locations")
}

model HorseMove {
  id                  String     @id @default(cuid())
  horseId             String
  fromLocationId      String?
  toLocationId        String
  departureDate       DateTime
  arrivalDate         DateTime?
  status              MoveStatus @default(PLANNED)
  driverName          String?
  driverServiceNumber String?
  boxGroomName        String?
  vehicleVRN          String?
  crew                Json?
  notes               String?
  name                String?
  groupId             String?
  createdById         String
  updatedById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  horse        Horse     @relation(fields: [horseId], references: [id], onDelete: Cascade)
  fromLocation Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location  @relation("ToLocation", fields: [toLocationId], references: [id])
  createdBy    User      @relation("MoveCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?     @relation("MoveUpdatedBy", fields: [updatedById], references: [id])

  @@index([groupId])
  @@index([horseId, departureDate]) // horse profile moves tab
  @@index([status, departureDate])  // moves list page filtered by status
  @@map("horse_moves")
}

model ExerciseAssignment {
  id            String   @id @default(cuid())
  horseId       String
  riderId       String
  assignedById  String
  exerciseName  String
  date          DateTime
  timeSlot      String
  duration      Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  horse      Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  rider      User  @relation("ExerciseRider", fields: [riderId], references: [id])
  assignedBy User  @relation("ExerciseAssignedBy", fields: [assignedById], references: [id])

  notifications ExerciseNotification[]

  @@index([date, timeSlot])
  @@index([horseId, date])
  @@index([riderId, date])
  @@map("exercise_assignments")
}

model ExerciseNotification {
  id                     String    @id @default(cuid())
  exerciseAssignmentId   String
  recipientId            String
  sentAt                 DateTime  @default(now())
  acknowledged           Boolean   @default(false)
  acknowledgedAt         DateTime?

  exerciseAssignment ExerciseAssignment @relation(fields: [exerciseAssignmentId], references: [id], onDelete: Cascade)
  recipient          User               @relation(fields: [recipientId], references: [id])

  @@map("exercise_notifications")
}

model FarrierRecord {
  id            String   @id @default(cuid())
  horseId       String
  serviceDate   DateTime
  shoeType      String?
  hoofCondition String?
  farrierName   String?
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  horse     Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdBy User  @relation("FarrierRecordCreatedBy", fields: [createdById], references: [id])

  @@index([horseId, serviceDate])
  @@map("farrier_records")
}

model FeedingPlan {
  id              String        @id @default(cuid())
  horseId         String
  feedType        FeedType
  quantityKg      Float
  frequency       FeedFrequency
  timeOfDay       String?
  specialNotes    String?
  startDate       DateTime      @default(now())
  endDate         DateTime?
  isActive        Boolean       @default(true)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  horse     Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdBy User  @relation("FeedingPlanCreatedBy", fields: [createdById], references: [id])

  @@map("feeding_plans")
}

model MedicationRecord {
  id                String          @id @default(cuid())
  horseId           String
  administeredById  String
  medicationName    String
  dosage            String
  route             MedicationRoute
  batchNumber       String?
  withdrawalDays    Int?
  withdrawalEndDate DateTime?
  notes             String?
  administeredAt    DateTime        @default(now())
  createdAt         DateTime        @default(now())

  horse          Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  administeredBy User  @relation("MedicationAdministeredBy", fields: [administeredById], references: [id])

  @@map("medication_records")
}

model TackItem {
  id           String        @id @default(cuid())
  type         TackType
  identifier   String        @unique
  brand        String?
  condition    TackCondition @default(SERVICEABLE)
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  allocations TackAllocation[]

  @@map("tack_items")
}

model TackAllocation {
  id            String    @id @default(cuid())
  tackItemId    String
  horseId       String
  assignedById  String
  fitNotes      String?
  startDate     DateTime  @default(now())
  endDate       DateTime?
  createdAt     DateTime  @default(now())

  tackItem   TackItem @relation(fields: [tackItemId], references: [id])
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  assignedBy User     @relation("TackAllocationAssignedBy", fields: [assignedById], references: [id])

  @@map("tack_allocations")
}

model InspectionSchedule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  frequencyDays Int
  isActive      Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   User         @relation("InspectionScheduleCreatedBy", fields: [createdById], references: [id])
  inspections Inspection[]

  @@map("inspection_schedules")
}

model Inspection {
  id                   String           @id @default(cuid())
  inspectionScheduleId String?
  horseId              String
  inspectorId          String
  result               InspectionResult
  findings             String?
  scheduledDate        DateTime
  completedAt          DateTime?
  createdAt            DateTime         @default(now())

  schedule  InspectionSchedule? @relation(fields: [inspectionScheduleId], references: [id])
  horse     Horse               @relation(fields: [horseId], references: [id], onDelete: Cascade)
  inspector User                @relation("InspectionPerformedBy", fields: [inspectorId], references: [id])

  @@map("inspections")
}

model Attachment {
  id             String             @id @default(cuid())
  fileName       String
  filePath       String
  mimeType       String
  fileSizeBytes  Int
  category       AttachmentCategory
  description    String?
  uploadedById   String
  horseId        String?
  injuryReportId String?
  createdAt      DateTime           @default(now())

  uploadedBy   User          @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  horse        Horse?        @relation("HorseAttachments", fields: [horseId], references: [id], onDelete: Cascade)
  injuryReport InjuryReport? @relation("InjuryAttachments", fields: [injuryReportId], references: [id], onDelete: Cascade)

  @@index([horseId, createdAt])     // horse profile documents tab
  @@index([injuryReportId])        // injury detail attachments
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userRole   String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
